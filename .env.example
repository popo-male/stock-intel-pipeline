# Local PostgreSQL Database for Testing (Docker Compose)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stock_db

# LLM Configuration (for Article Summaries and Key Highlights)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=openai/gpt-oss-120b
STRICT_LLM_FAILURE=false

# Optional Watchlist Override (Comma-separated ticker symbols)
WATCHLIST=AAPL,MSFT,GOOGL,AMZN,NVDA,META,TSLA